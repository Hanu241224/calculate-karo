@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  html {
    text-rendering: geometricPrecision;
  }

  body {
    @apply antialiased text-white bg-[#ff310d] font-sans selection:bg-orange-200 selection:text-orange-200;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    letter-spacing: 0;
    margin: 0;
  }

  h1,
  h2,
  h3,
  h4,
  p,
  a,
  button,
  input,
  span,
  label {
    letter-spacing: 0;
  }
}

@layer components {
  .heading-display {
    @apply text-3xl font-semibold leading-tight text-black md:text-4xl;
  }

  .heading-section {
    @apply text-xl font-semibold leading-snug text-black;
  }

  .eyebrow {
    @apply text-xs font-semibold uppercase text-[#f4510b];
    letter-spacing: 0;
  }

  .panel-surface {
    @apply rounded-[20px] border border-black/10 bg-white text-[#101014];
    box-shadow: 0 18px 44px rgb(0 0 0 / 0.06);
  }

  .smooth-control {
    @apply transition-all duration-200 ease-out;
  }

  .category-reference-split {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 1024px) {
    .category-reference-split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
}

@layer utilities {
  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  .animate-float-delayed {
    animation: float 6s ease-in-out 3s infinite;
  }

  .animate-pulse-slow {
    animation: pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  .no-shadow {
    box-shadow: none !important;
  }
}

@keyframes float {
  0% { transform: translateY(0px); }
  50% { transform: translateY(-15px); }
  100% { transform: translateY(0px); }
}

/* Homepage and AI workspace */
.workspace-page {
  --workspace-orange: #ff310d;
  --workspace-orange-deep: #b1280d;
  --workspace-orange-dark: #6a260f;
  --workspace-ink: #050505;
  --workspace-line: #c8c8c8;
  --workspace-paper: #fff;
  --workspace-composer: #f6f6f6;
  min-height: 100vh;
  width: 100%;
  box-sizing: border-box;

  background:
    linear-gradient(180deg, var(--workspace-orange) 0 44%, var(--workspace-orange-deep) 74%, var(--workspace-orange-dark) 100%);
  color: var(--workspace-ink);
  transition: background-color 220ms ease, color 220ms ease;
}

.workspace-page--dim {
  --workspace-paper: #171717;
  --workspace-ink: #f8f8f8;
  --workspace-line: #3d3d3d;
  --workspace-composer: #242424;
}

.workspace-header {
  position: sticky;
  top: 0;
  z-index: 80;
  background-color: var(--workspace-paper);
  display: grid;
  height: 60px;
  max-height: 60px;
  grid-template-columns: minmax(360px, 720px) 1fr;
  align-items: center;
  gap: 18px;
  padding: 0 22px;
}

.workspace-header__left {
  display: grid;
  min-width: 0;
  grid-template-columns: auto minmax(180px, 1fr);
  align-items: center;
  gap: 12px;
}

.workspace-logo {
  display: flex;
  height: 40px;
  min-width: 0;
  align-items: center;
  gap: 9px;
  overflow: auto;
  color: #050505;
  transition: opacity 180ms ease;
}

.workspace-logo:hover {
  opacity: 0.72;
}

.workspace-search-pill {
  display: flex;
  height: 40px;
  min-width: 0;
  align-items: center;
  justify-content: center;
  gap: 10px;
  overflow: auto;
  border-radius: 20px;
  background: #9c210d;
  padding: 0 18px;
  color: rgb(255 255 255 / 0.76);
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
  transition: background-color 180ms ease, color 180ms ease;
}

.workspace-search-pill:hover {
  background: #861d0d;
  color: white;
}

.workspace-search-pill input {
  min-width: 0;
  width: 100%;
  border: 0;
  background: transparent;
  color: white;
  font: inherit;
  outline: none;
}

.workspace-search-pill input::placeholder {
  color: rgb(255 255 255 / 0.72);
}

.workspace-brand__mark {
  display: flex;
  height: 30px;
  width: 30px;
  flex: 0 0 30px;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: white;
  color: #ee340e;
}

.workspace-brand__name {
  white-space: nowrap;
  font-size: 18px;
  font-weight: 700;
}

.workspace-header__nav {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: flex-end;
  gap: 18px;
}

.workspace-nav-link {
  display: inline-flex;
  height: 44px;
  align-items: center;
  gap: 7px;
  border: 0;
  background: transparent;
  color: #050505;
  font-size: 17px;
  font-weight: 450;
  white-space: nowrap;
  transition: opacity 180ms ease;
}

.workspace-nav-link:hover,
.workspace-nav-link.is-active {
  opacity: 0.62;
}

.workspace-nav-link svg {
  transition: transform 180ms ease;
}

.workspace-blog-menu {
  position: relative;
}

.workspace-blog-dropdown {
  position: absolute;
  top: 58px;
  right: 0;
  z-index: 30;
  width: 320px;
  border: 1px solid rgb(0 0 0 / 0.13);
  border-radius: 20px;
  background: white;
  padding: 18px;
  box-shadow: 0 24px 60px rgb(62 16 4 / 0.2);
}

.workspace-blog-dropdown > p {
  margin-bottom: 10px;
  color: #8a8a8a;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
}

.workspace-blog-dropdown > a {
  display: block;
  border-radius: 8px;
  padding: 9px 10px;
  color: #171717;
  font-size: 13px;
  font-weight: 550;
  line-height: 1.35;
}

.workspace-blog-dropdown > a:hover {
  background: #fff1ed;
}

.workspace-blog-dropdown > .workspace-blog-dropdown__all {
  display: flex;
  margin-top: 8px;
  align-items: center;
  justify-content: space-between;
  background: #101010;
  color: white;
}

.workspace-theme-toggle {
  position: relative;
  display: flex;
  height: 38px;
  width: 74px;
  flex: 0 0 74px;
  align-items: center;
  border: 0;
  border-radius: 20px;
  background: #ffb900;
  padding: 4px;
}

.workspace-theme-toggle span {
  display: flex;
  height: 30px;
  width: 30px;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ff5a13;
  color: white;
  transition: transform 200ms ease;
}

.workspace-page--dim .workspace-theme-toggle span {
  transform: translateX(36px);
}

.workspace-sign-in {
  display: inline-flex;
  height: 38px;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 20px;
  background: #030303;
  padding: 0 20px;
  color: white;
  font-size: 19px;
  font-weight: 450;
  white-space: nowrap;
  transition: transform 180ms ease, background-color 180ms ease;
}

.workspace-sign-in:hover {
  transform: translateY(-1px);
  background: #252525;
}

.workspace-frame {
  display: grid;
  min-height: calc(100vh - 60px);
  min-height: 600px;
  margin: 0;
  grid-template-columns: 60px minmax(0, 1fr);

  border-radius: 20px 20px 0 0;
  background: #f4f4f4;
  color: var(--workspace-ink);
  transition: background-color 220ms ease, color 220ms ease;
}

.workspace-frame--panel-open {
  grid-template-columns: 336px minmax(0, 1fr);
}

.workspace-sidebar {
  position: sticky;
  top: 60px;
  height: calc(100vh - 60px);
  align-self: start;
  display: grid;
  min-width: 0;
  width: 60px;
  max-width: 60px;
  grid-template-columns: 60px 0;
  overflow: auto;
  border: none;
  border-radius: 20px 0 0 0;
  transition: width 180ms ease, max-width 180ms ease, grid-template-columns 180ms ease;
}

.workspace-frame--panel-open .workspace-sidebar {
  width: 336px;
  max-width: 336px;
  grid-template-columns: 60px minmax(0, 276px);
}

.workspace-sidebar__rail {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  border-right: none;
  background: #f4f4f4;
}

.workspace-panel-toggle {
  display: flex;
  height: 72px;
  width: 100%;
  align-items: center;
  justify-content: center;
  border: 0;
  background: transparent;
  color: var(--workspace-ink);
}

.workspace-panel-toggle svg {
  transition: transform 220ms ease;
}

.workspace-rail-actions {
  display: flex;
  margin-top: 12px;
  flex: 1;
  flex-direction: column;
  align-items: stretch;
  gap: 8px;
  opacity: 1;
  transform: none;
  pointer-events: auto;
  transition: opacity 180ms ease, transform 180ms ease;
}

.workspace-frame--panel-open .workspace-rail-actions {
  opacity: 1;
  transform: translateX(0);
  pointer-events: auto;
}

.workspace-rail-link {
  position: relative;
  display: flex;
  height: 44px;
  align-items: center;
  justify-content: center;
  color: #7a7a7a;
  transition: color 170ms ease, background-color 170ms ease;
}

.workspace-rail-link::before {
  position: absolute;
  inset: 0 auto 0 0;
  width: 5px;
  background: #ff310d;
  content: '';
  opacity: 0;
}

.workspace-rail-link:hover,
.workspace-rail-link.is-active {
  background: #fff1ed;
  color: #ff310d;
}

.workspace-rail-link.is-active::before {
  opacity: 1;
}

.workspace-page--dim .workspace-rail-link:hover,
.workspace-page--dim .workspace-rail-link.is-active {
  background: #2d201c;
}

.workspace-sidebar__panel {
  min-width: 0;
  width: 0;
  overflow: auto;
  opacity: 0;
  transform: translateX(-16px);
  pointer-events: none;
  transition: opacity 180ms ease, transform 180ms ease;
}

.workspace-frame--panel-open .workspace-sidebar__panel {
  width: auto;
  opacity: 1;
  transform: translateX(0);
  pointer-events: auto;
}

.workspace-panel-heading {
  display: flex;
  height: 72px;
  align-items: center;
  justify-content: space-between;
  padding: 0 18px;
  border-bottom: 1px solid var(--workspace-line);
}

.workspace-panel-heading span {
  display: block;
  margin-bottom: 3px;
  color: #ff310d;
  font-size: 10px;
  font-weight: 750;
  text-transform: uppercase;
}

.workspace-panel-heading h2 {
  font-size: 18px;
  font-weight: 620;
}

.workspace-panel-heading button {
  display: flex;
  height: 34px;
  width: 34px;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 50%;
  background: #f3f3f3;
  color: #111;
}

.workspace-panel-content {
  height: calc(100% - 72px);
  overflow-y: visible;
  padding: 12px 16px 22px;
}

.workspace-category-group {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 4px 10px;
  padding: 12px 2px;
  border-bottom: 1px solid var(--workspace-line);
}

.workspace-category-group > a {
  color: var(--workspace-ink);
  font-size: 13px;
  font-weight: 650;
}

.workspace-category-group > span {
  color: #ff310d;
  font-size: 12px;
  font-weight: 700;
}

.workspace-category-group > div {
  display: grid;
  grid-column: 1 / -1;
  gap: 7px;
  margin-top: 7px;
}

.workspace-category-group > div a {
  color: #777;
  font-size: 12px;
  font-weight: 500;
}

.workspace-category-group a:hover {
  color: #ff310d;
}

.workspace-canvas {
  position: relative;
  min-width: 0;
  background: #f4f4f4;
}

.site-workspace-frame {
  min-min-height: calc(100vh - 60px);
}

.site-workspace-main {
  min-width: 0;
  overflow-y: visible;
  padding: 0;
  background: #f4f4f4;
  color: var(--workspace-ink);
}

.site-workspace-main > * {
  margin: 0 !important;
}

.site-rail-actions {
  opacity: 1;
  transform: none;
  pointer-events: auto;
}

/* Homepage */
.home-page {
  display: grid;
  gap: 34px;
  padding: 0;

  color: #101014;
}

.home-hero {
  display: grid;
  min-height: 430px;
  grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.72fr);
  gap: 28px;
  overflow: auto;
  border-radius: 20px;
  background:
    linear-gradient(120deg, #ff6f2a 0%, #ff310d 46%, #75230d 100%);
  padding: 46px;
  color: white;
}

.home-kicker,
.section-kicker {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #ff310d;
  font-size: 11px;
  font-weight: 850;
  text-transform: uppercase;
}

.home-kicker {
  color: #fff4ee;
}

.home-hero__copy h1 {
  max-width: 760px;
  margin-top: 22px;
  font-size: clamp(48px, 7vw, 92px);
  font-weight: 780;
  line-height: 0.92;
}

.home-hero__copy p {
  max-width: 620px;
  margin-top: 24px;
  color: rgb(255 255 255 / 0.82);
  font-size: 17px;
  font-weight: 600;
  line-height: 1.7;
}

.home-hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 30px;
}

.home-primary-action,
.home-secondary-action,
.home-panel-link,
.home-insight-card a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border-radius: 20px;
  font-size: 13px;
  font-weight: 850;
}

.home-primary-action {
  min-height: 48px;
  background: #050505;
  padding: 0 22px;
  color: white;
}

.home-secondary-action {
  min-height: 48px;
  border: 1px solid rgb(255 255 255 / 0.35);
  padding: 0 20px;
  color: white;
}

.home-hero__panel,
.home-insight-card {
  border: 1px solid rgb(255 255 255 / 0.16);
  border-radius: 20px;
  background: rgb(5 5 5 / 0.55);
  padding: 24px;
  box-shadow: 0 24px 70px rgb(0 0 0 / 0.22);
}

.home-panel-top {
  display: flex;
  gap: 14px;
}

.home-panel-top > span {
  display: flex;
  height: 44px;
  width: 44px;
  flex: 0 0 44px;
  align-items: center;
  justify-content: center;
  border-radius: 16px;
  background: #ff7a2d;
  color: #111;
}

.home-panel-top strong,
.home-insight-card h2 {
  display: block;
  color: white;
  font-size: 22px;
  font-weight: 800;
}

.home-panel-top p,
.home-insight-card p {
  margin-top: 7px;
  color: rgb(255 255 255 / 0.68);
  font-size: 13px;
  font-weight: 600;
  line-height: 1.7;
}

.home-metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-top: 28px;
}

.home-metric-grid div {
  border-radius: 18px;
  background: rgb(255 255 255 / 0.1);
  padding: 18px;
}

.home-metric-grid strong {
  display: block;
  color: white;
  font-size: 30px;
  font-weight: 850;
}

.home-metric-grid span {
  display: block;
  margin-top: 3px;
  color: rgb(255 255 255 / 0.56);
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
}

.home-panel-link {
  width: 100%;
  min-height: 48px;
  margin-top: 22px;
  background: white;
  color: #101014;
}

.home-section {
  display: grid;
  gap: 20px;
}

.home-section__heading span {
  color: #ff310d;
  font-size: 11px;
  font-weight: 850;
  text-transform: uppercase;
}

.home-section__heading h2,
.category-product-bottom h2 {
  margin-top: 6px;
  color: #101014;
  font-size: 32px;
  font-weight: 850;
  line-height: 1;
}

.home-category-grid,
.home-blog-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}

.home-category-card,
.home-blog-card,
.home-tool-row,
.category-related-tool,
.category-blog-list a {
  border: 1px solid rgb(0 0 0 / 0.1);
  border-radius: 20px;
  background: white;
  color: #101014;
  transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
}

.home-category-card:hover,
.home-blog-card:hover,
.home-tool-row:hover,
.category-related-tool:hover,
.category-blog-list a:hover {
  transform: translateY(-2px);
  border-color: #ff782f;
  box-shadow: 0 18px 42px rgb(0 0 0 / 0.08);
}

.home-category-card {
  position: relative;
  min-height: 190px;
  padding: 22px;
}

.home-category-card > span {
  display: flex;
  height: 46px;
  width: 46px;
  align-items: center;
  justify-content: center;
  border-radius: 16px;
  background: #fff1ed;
  color: #ff310d;
}

.home-category-card small {
  position: absolute;
  top: 22px;
  right: 22px;
  border-radius: 12px;
  background: #f4f4f4;
  padding: 7px 10px;
  color: #555;
  font-size: 11px;
  font-weight: 800;
}

.home-category-card h3 {
  margin-top: 28px;
  font-size: 21px;
  font-weight: 850;
}

.home-category-card p,
.home-section__heading p,
.category-product-bottom > div > p {
  margin-top: 9px;
  color: rgb(0 0 0 / 0.56);
  font-size: 13px;
  font-weight: 650;
  line-height: 1.6;
}

.home-split {
  grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.65fr);
  align-items: stretch;
}

.home-tool-list {
  display: grid;
  gap: 12px;
  margin-top: 20px;
}

.home-tool-row {
  display: grid;
  grid-template-columns: 48px minmax(0, 1fr) auto;
  gap: 16px;
  align-items: center;
  padding: 16px;
}

.home-tool-row > span,
.category-related-tool > span {
  display: flex;
  height: 48px;
  width: 48px;
  align-items: center;
  justify-content: center;
  border-radius: 16px;
  background: #ff782f;
  color: white;
}

.home-tool-row h3,
.category-related-tool h3,
.category-blog-list h3,
.home-blog-card h3 {
  font-size: 15px;
  font-weight: 850;
}

.home-tool-row p,
.category-related-tool p,
.category-blog-list p,
.home-blog-card p {
  margin-top: 4px;
  color: rgb(0 0 0 / 0.52);
  font-size: 12px;
  font-weight: 650;
  line-height: 1.45;
}

.home-tool-row strong {
  color: #ff310d;
  font-size: 12px;
  font-weight: 850;
}

.home-insight-card {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-height: 300px;
  background: #080808;
  color: white;
}

.home-insight-card svg {
  color: #ff782f;
}

.home-insight-card a {
  align-self: flex-start;
  min-height: 44px;
  margin-top: 22px;
  background: #ff782f;
  padding: 0 18px;
  color: #101014;
}

.home-blog-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.home-blog-card {
  overflow: auto;
}

.home-blog-card img {
  height: 170px;
  width: 100%;
  object-fit: cover;
}

.home-blog-card div {
  padding: 18px;
}

.home-blog-card small {
  color: #ff310d;
  font-size: 11px;
  font-weight: 850;
}

.category-home-page {

}

.category-home-hero {
  min-height: 410px;
}

.category-home-tool-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}

.category-home-tool-card {
  position: relative;
  min-height: 230px;
  border: 1px solid rgb(0 0 0 / 0.1);
  border-radius: 20px;
  background: white;
  padding: 22px;
  color: #101014;
  transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
}

.category-home-tool-card:hover,
.category-home-tool-card.is-featured {
  transform: translateY(-2px);
  border-color: #ff782f;
  box-shadow: 0 18px 42px rgb(0 0 0 / 0.08);
}

.category-home-tool-card.is-featured {
  background: #101014;
  color: white;
}

.category-home-tool-card > span {
  display: flex;
  height: 46px;
  width: 46px;
  align-items: center;
  justify-content: center;
  border-radius: 16px;
  background: #fff1ed;
  color: #ff310d;
}

.category-home-tool-card.is-featured > span {
  background: #ff782f;
  color: white;
}

.category-home-tool-card small {
  position: absolute;
  top: 22px;
  right: 22px;
  border-radius: 12px;
  background: #f4f4f4;
  padding: 7px 10px;
  color: #555;
  font-size: 11px;
  font-weight: 850;
}

.category-home-tool-card.is-featured small {
  background: rgb(255 255 255 / 0.12);
  color: rgb(255 255 255 / 0.72);
}

.category-home-tool-card h3 {
  margin-top: 26px;
  color: inherit;
  font-size: 21px;
  font-weight: 850;
}

.category-home-tool-card p {
  margin-top: 9px;
  color: rgb(0 0 0 / 0.56);
  font-size: 13px;
  font-weight: 650;
  line-height: 1.55;
}

.category-home-tool-card.is-featured p {
  color: rgb(255 255 255 / 0.66);
}

.category-home-tool-card strong {
  display: block;
  margin-top: 18px;
  color: #ff310d;
  font-size: 10px;
  font-weight: 850;
  text-transform: uppercase;
}

.category-home-tool-card.is-featured strong {
  color: #ffb48a;
}

.category-workflow-list {
  display: grid;
  gap: 12px;
  margin-top: 20px;
}

.category-workflow-step {
  display: grid;
  grid-template-columns: 58px minmax(0, 1fr);
  gap: 16px;
  align-items: start;
  border: 1px solid rgb(0 0 0 / 0.1);
  border-radius: 20px;
  background: white;
  padding: 18px;
}

.category-workflow-step > span {
  display: flex;
  height: 48px;
  align-items: center;
  justify-content: center;
  border-radius: 16px;
  background: #ff782f;
  color: white;
  font-size: 13px;
  font-weight: 850;
}

.category-workflow-step h3 {
  color: #101014;
  font-size: 16px;
  font-weight: 850;
}

.category-workflow-step p {
  margin-top: 5px;
  color: rgb(0 0 0 / 0.54);
  font-size: 13px;
  font-weight: 650;
  line-height: 1.55;
}

.category-home-insight {
  background:
    linear-gradient(145deg, #101014, #291108 62%, #ff310d 180%);
}

/* Category pages aligned with tool pages */
.category-product-page {
  background: #f5f2eb;
  color: #101014;
}

.category-product-top {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(360px, 0.92fr);
  min-height: 640px;
}

.category-product-left {
  position: relative;
  background: #ff782f;
  padding: 46px;
}

.category-product-left::after {
  position: absolute;
  top: 50%;
  right: -10px;
  width: 0;
  height: 0;
  border-top: 10px solid transparent;
  border-bottom: 10px solid transparent;
  border-left: 10px solid #ff782f;
  content: '';
}

.tool-breadcrumb {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  color: rgb(0 0 0 / 0.56);
  font-size: 11px;
  font-weight: 800;
}

.tool-breadcrumb a:hover {
  color: #101014;
}

.category-title-row {
  display: flex;
  gap: 16px;
  align-items: center;
  margin-top: 34px;
}

.category-title-row > span {
  display: flex;
  height: 48px;
  width: 48px;
  align-items: center;
  justify-content: center;
  border-radius: 18px;
  background: #101014;
  color: white;
}

.category-title-row p {
  color: rgb(0 0 0 / 0.55);
  font-size: 11px;
  font-weight: 850;
  text-transform: uppercase;
}

.category-title-row h1 {
  margin-top: 4px;
  color: white;
  font-size: clamp(42px, 6vw, 76px);
  font-weight: 850;
  line-height: 0.92;
}

.category-lede {
  max-width: 640px;
  margin-top: 26px;
  color: rgb(255 255 255 / 0.82);
  font-size: 15px;
  font-weight: 650;
  line-height: 1.7;
}

.category-tool-grid {
  display: grid;
  gap: 12px;
  margin-top: 34px;
}

.category-tool-grid a {
  display: grid;
  grid-template-columns: 44px minmax(0, 1fr) auto;
  gap: 14px;
  align-items: center;
  border: 1px solid rgb(0 0 0 / 0.12);
  border-radius: 20px;
  background: rgb(255 255 255 / 0.12);
  padding: 14px;
  color: #101014;
}

.category-tool-grid a.is-active,
.category-tool-grid a:hover {
  background: #101014;
  color: white;
}

.category-tool-grid a > span {
  display: flex;
  height: 44px;
  width: 44px;
  align-items: center;
  justify-content: center;
  border-radius: 16px;
  background: rgb(255 255 255 / 0.22);
}

.category-tool-grid h2 {
  color: inherit;
  font-size: 15px;
  font-weight: 850;
}

.category-tool-grid p {
  margin-top: 3px;
  color: currentColor;
  font-size: 10px;
  font-weight: 850;
  opacity: 0.55;
  text-transform: uppercase;
}

.category-tool-grid small {
  font-size: 11px;
  font-weight: 850;
}

.category-action-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 30px;
}

.category-calculate-action {
  display: inline-flex;
  min-height: 46px;
  min-width: 230px;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transform: skewX(-10deg);
  background: #101014;
  color: white;
  font-size: 12px;
  font-weight: 850;
  text-transform: uppercase;
}

.category-calculate-action > * {
  transform: skewX(10deg);
}

.category-product-right {
  background: #f8f6f1;
  padding: 46px;
}

.category-result-label {
  font-size: 20px;
  font-weight: 650;
}

.category-product-right > h2 {
  margin-top: 20px;
  color: #101014;
  font-size: 56px;
  font-weight: 900;
  line-height: 0.95;
}

.category-result-copy {
  max-width: 520px;
  margin-top: 14px;
  color: rgb(0 0 0 / 0.58);
  font-size: 13px;
  font-weight: 650;
  line-height: 1.65;
}

.category-progress-list {
  display: grid;
  gap: 12px;
  margin-top: 36px;
}

.category-progress-row {
  display: grid;
  grid-template-columns: 0.75fr minmax(80px, 1fr) auto;
  gap: 14px;
  align-items: center;
  font-size: 11px;
  font-weight: 850;
}

.category-progress-row span {
  color: rgb(0 0 0 / 0.55);
}

.category-progress-row i {
  height: 1px;
  background: rgb(0 0 0 / 0.16);
}

.category-progress-row b {
  display: block;
  height: 1px;
  background: #101014;
}

.category-mode-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-top: 40px;
}

.category-mode-grid span {
  display: flex;
  height: 62px;
  align-items: center;
  justify-content: center;
  background: rgb(0 0 0 / 0.05);
  font-size: 11px;
  font-weight: 850;
  text-transform: uppercase;
}

.category-mode-grid span.is-active {
  background: #101014;
  color: white;
  box-shadow: 0 12px 28px rgb(0 0 0 / 0.22);
}

.category-confidence {
  margin-top: 38px;
}

.category-confidence h3 {
  font-size: 22px;
  font-weight: 650;
}

.category-confidence p {
  max-width: 520px;
  margin-top: 10px;
  color: rgb(0 0 0 / 0.55);
  font-size: 13px;
  font-weight: 650;
  line-height: 1.65;
}

.category-confidence > div {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  margin-top: 24px;
}

.category-confidence span {
  border-top: 1px solid rgb(0 0 0 / 0.16);
  padding-top: 14px;
  text-align: center;
  color: rgb(0 0 0 / 0.45);
  font-size: 10px;
  font-weight: 850;
  text-transform: uppercase;
}

.category-confidence span.is-active {
  color: #101014;
}

.category-separator {
  height: 1px;
  background: rgb(0 0 0 / 0.14);
}

.category-product-bottom {
  display: grid;
  grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
  gap: 44px;
  background: #f7f5f0;
  padding: 44px 46px;
}

.category-related-tools,
.category-blog-list {
  display: grid;
  gap: 12px;
  margin-top: 22px;
}

.category-related-tool,
.category-blog-list a {
  display: grid;
  grid-template-columns: 52px minmax(0, 1fr) auto;
  gap: 16px;
  align-items: center;
  padding: 16px;
}

/* Search page */
.search-page {
  display: grid;
  gap: 24px;
  background: #fff;
  color: #101014;
}

.search-hero {
  border-radius: 20px;
  background: linear-gradient(120deg, #ff782f, #ff310d 52%, #731f0b);
  padding: 40px;
  color: white;
}

.search-hero > span {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  font-weight: 850;
  text-transform: uppercase;
}

.search-hero h1 {
  max-width: 820px;
  margin-top: 18px;
  font-size: clamp(38px, 6vw, 72px);
  font-weight: 850;
  line-height: 0.95;
}

.search-hero p {
  max-width: 600px;
  margin-top: 16px;
  color: rgb(255 255 255 / 0.78);
  font-size: 15px;
  font-weight: 650;
  line-height: 1.6;
}

.search-hero strong {
  display: inline-flex;
  margin-top: 22px;
  border-radius: 20px;
  background: #101014;
  padding: 12px 16px;
  font-size: 12px;
  font-weight: 850;
  text-transform: uppercase;
}

.search-results-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.search-group {
  border: 1px solid rgb(0 0 0 / 0.1);
  border-radius: 20px;
  background: #f8f6f1;
  overflow: auto;
}

.search-group__heading {
  display: flex;
  gap: 14px;
  align-items: center;
  border-bottom: 1px solid rgb(0 0 0 / 0.1);
  padding: 18px;
}

.search-group__heading > span {
  display: flex;
  height: 44px;
  width: 44px;
  align-items: center;
  justify-content: center;
  border-radius: 16px;
  background: #ff782f;
  color: white;
}

.search-group__heading h2 {
  color: #101014;
  font-size: 20px;
  font-weight: 850;
}

.search-group__heading p {
  color: rgb(0 0 0 / 0.5);
  font-size: 12px;
  font-weight: 750;
}

.search-group__list {
  display: grid;
  gap: 10px;
  padding: 14px;
}

.search-result-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 14px;
  align-items: center;
  border: 1px solid rgb(0 0 0 / 0.08);
  border-radius: 18px;
  background: white;
  padding: 16px;
  color: #101014;
  transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
}

.search-result-card:hover {
  transform: translateY(-2px);
  border-color: #ff782f;
  box-shadow: 0 16px 36px rgb(0 0 0 / 0.08);
}

.search-result-card h2 {
  color: #101014;
  font-size: 15px;
  font-weight: 850;
}

.search-result-card p {
  margin-top: 4px;
  color: rgb(0 0 0 / 0.52);
  font-size: 12px;
  font-weight: 650;
  line-height: 1.45;
}

.search-result-card small {
  display: block;
  margin-top: 8px;
  color: #ff310d;
  font-size: 10px;
  font-weight: 850;
  text-transform: uppercase;
}

.search-empty {
  border-radius: 18px;
  background: white;
  padding: 18px;
  color: rgb(0 0 0 / 0.52);
  font-size: 13px;
  font-weight: 700;
}

/* Compact UI tuning */
.site-workspace-main {
  padding: 0;
}

.home-page,
.search-page {
  gap: 20px;
}

.home-hero,
.category-home-hero {
  min-height: 320px;
  gap: 20px;
  padding: 28px;
}

.home-hero__copy h1,
.search-hero h1 {
  margin-top: 14px;
  font-size: clamp(34px, 4.8vw, 58px);
  line-height: 0.98;
}

.home-hero__copy p,
.search-hero p {
  margin-top: 14px;
  font-size: 14px;
  line-height: 1.55;
}

.home-hero__actions {
  gap: 10px;
  margin-top: 20px;
}

.home-primary-action,
.home-secondary-action,
.home-panel-link,
.home-insight-card a {
  min-height: 38px;
  border-radius: 16px;
  padding: 0 15px;
  font-size: 12px;
}

.home-hero__panel,
.home-insight-card {
  padding: 18px;
}

.home-panel-top > span {
  height: 38px;
  width: 38px;
  flex-basis: 38px;
}

.home-panel-top strong,
.home-insight-card h2 {
  font-size: 18px;
}

.home-panel-top p,
.home-insight-card p {
  font-size: 12px;
  line-height: 1.5;
}

.home-metric-grid {
  gap: 9px;
  margin-top: 18px;
}

.home-metric-grid div {
  padding: 12px;
}

.home-metric-grid strong {
  font-size: 22px;
}

.home-section {
  gap: 14px;
}

.home-section__heading h2,
.category-product-bottom h2 {
  font-size: 24px;
}

.home-category-grid,
.home-blog-grid,
.category-home-tool-grid,
.search-results-grid {
  gap: 12px;
}

.home-category-card,
.category-home-tool-card {
  min-height: 158px;
  padding: 16px;
}

.home-category-card > span,
.category-home-tool-card > span {
  height: 38px;
  width: 38px;
}

.home-category-card small,
.category-home-tool-card small {
  top: 16px;
  right: 16px;
  padding: 5px 8px;
  font-size: 10px;
}

.home-category-card h3,
.category-home-tool-card h3 {
  margin-top: 18px;
  font-size: 17px;
}

.home-category-card p,
.category-home-tool-card p,
.home-section__heading p {
  font-size: 12px;
  line-height: 1.45;
}

.category-home-tool-card {
  min-height: 185px;
}

.category-home-tool-card strong {
  margin-top: 12px;
  font-size: 9px;
}

.home-tool-list,
.category-workflow-list {
  gap: 9px;
  margin-top: 14px;
}

.home-tool-row,
.category-workflow-step {
  grid-template-columns: 40px minmax(0, 1fr) auto;
  gap: 12px;
  padding: 12px;
}

.category-workflow-step {
  grid-template-columns: 46px minmax(0, 1fr);
}

.home-tool-row > span,
.category-related-tool > span,
.category-workflow-step > span {
  height: 40px;
  width: 40px;
}

.home-tool-row h3,
.category-workflow-step h3,
.home-blog-card h3,
.search-result-card h2 {
  font-size: 14px;
}

.home-tool-row p,
.category-workflow-step p,
.home-blog-card p,
.search-result-card p {
  font-size: 11px;
  line-height: 1.38;
}

.home-insight-card {
  min-height: 220px;
}

.home-blog-card img {
  height: 120px;
}

.home-blog-card div,
.search-group__heading,
.search-result-card {
  padding: 13px;
}

.search-hero {
  padding: 26px;
}

.search-group__heading > span {
  height: 38px;
  width: 38px;
}

.search-group__heading h2 {
  font-size: 17px;
}

.search-group__list {
  gap: 8px;
  padding: 10px;
}

.workspace-conversation {
  height: calc(100% - 122px);
  padding: 28px 22px 16px;
}

.workspace-composer-wrap {
  right: 34px;
  bottom: 28px;
  left: 34px;
}

.workspace-composer {
  height: 104px;
  grid-template-columns: 46px minmax(0, 1fr) 46px auto;
  padding: 0 22px 0 14px;
}

.workspace-composer__icon {
  height: 42px;
  width: 42px;
}

.workspace-composer__icon svg {
  height: 24px;
  width: 24px;
}

.workspace-go {
  height: 36px;
  min-width: 56px;
  font-size: 17px;
}

.workspace-conversation {
  display: flex;
  height: calc(100% - 180px);
  max-width: 810px;
  margin: 0 auto;
  flex-direction: column;
  gap: 14px;
  overflow-y: visible;
  padding: 52px 28px 24px;
}

.workspace-message {
  display: flex;
  width: fit-content;
  max-width: min(680px, 90%);
  gap: 10px;
  border-radius: 18px;
  padding: 14px 16px;
  font-size: 14px;
  line-height: 1.55;
}

.workspace-message--user {
  margin-left: auto;
  background: #111;
  color: white;
}

.workspace-message--assistant {
  align-items: flex-start;
  background: #f4f4f4;
  color: #171717;
}

.workspace-page--dim .workspace-message--assistant {
  background: #2a2a2a;
  color: white;
}

.workspace-message--assistant > span {
  display: flex;
  height: 30px;
  width: 30px;
  flex: 0 0 30px;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ff310d;
  color: white;
}

.workspace-composer-wrap {
  position: absolute;
  right: 56px;
  bottom: 46px;
  left: 56px;
}

.workspace-composer {
  display: grid;
  height: 156px;
  grid-template-columns: 64px minmax(0, 1fr) 64px auto;
  align-items: center;
  gap: 12px;
  border-radius: 20px;
  background: var(--workspace-composer);
  padding: 0 36px 0 22px;
}

.workspace-composer > input:not([type='file']) {
  min-width: 0;
  border: 0;
  background: transparent;
  color: var(--workspace-ink);
  font-size: 17px;
  outline: none;
}

.workspace-composer > input::placeholder {
  color: #9a9a9a;
  opacity: 0;
  transition: opacity 160ms ease;
}

.workspace-composer:focus-within > input::placeholder {
  opacity: 1;
}

.workspace-composer__icon {
  display: flex;
  height: 54px;
  width: 54px;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: var(--workspace-ink);
  transition: background-color 160ms ease, color 160ms ease;
}

.workspace-composer__icon:hover {
  background: #e9e9e9;
}

.workspace-page--dim .workspace-composer__icon:hover {
  background: #353535;
}

.workspace-composer__icon.is-listening {
  background: #ff310d;
  color: white;
}

.workspace-go {
  display: inline-flex;
  height: 42px;
  min-width: 68px;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 20px;
  background: #030303;
  color: white;
  font-size: 22px;
  font-weight: 450;
  transition: transform 160ms ease, background-color 160ms ease;
}

.workspace-go:hover {
  transform: translateY(-1px);
  background: #ff310d;
}

.workspace-attachment {
  display: inline-flex;
  margin: 0 0 10px 30px;
  align-items: center;
  gap: 10px;
  border-radius: 20px;
  background: #111;
  padding: 8px 10px 8px 14px;
  color: white;
  font-size: 12px;
}

.workspace-attachment button {
  display: flex;
  height: 22px;
  width: 22px;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 50%;
  background: #333;
  color: white;
}

.workspace-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgb(0 0 0 / 0.54);
  padding: 20px;
  backdrop-filter: blur(8px);
}

.workspace-modal {
  position: relative;
  width: min(420px, 100%);
  border-radius: 20px;
  background: white;
  padding: 34px;
  color: #111;
  box-shadow: 0 30px 90px rgb(0 0 0 / 0.35);
}

.workspace-modal__close {
  position: absolute;
  top: 18px;
  right: 18px;
  display: flex;
  height: 34px;
  width: 34px;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 50%;
  background: #f2f2f2;
}

.workspace-modal__mark {
  display: flex;
  height: 48px;
  width: 48px;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ff310d;
  color: white;
}

.workspace-modal h2 {
  margin-top: 22px;
  font-size: 30px;
  font-weight: 650;
}

.workspace-modal p {
  margin-top: 8px;
  color: #686868;
  font-size: 14px;
  line-height: 1.55;
}

.workspace-modal label {
  display: grid;
  gap: 7px;
  margin-top: 24px;
  font-size: 12px;
  font-weight: 650;
}

.workspace-modal label input {
  height: 48px;
  border: 1px solid #d6d6d6;
  border-radius: 10px;
  padding: 0 13px;
  outline: none;
}

.workspace-modal label input:focus {
  border-color: #ff310d;
}

.workspace-modal > button:last-child {
  height: 48px;
  width: 100%;
  margin-top: 14px;
  border: 0;
  border-radius: 10px;
  background: #111;
  color: white;
  font-size: 14px;
  font-weight: 650;
}

@media (max-width: 1240px) {
  .workspace-header {
    grid-template-columns: minmax(320px, 1fr) auto;
    gap: 18px;
    padding: 0 18px;
  }

  .workspace-header__nav {
    gap: 16px;
  }

  .workspace-nav-link {
    font-size: 17px;
  }

  .workspace-frame {
    grid-template-columns: 60px minmax(0, 1fr);
  }

  .workspace-frame--panel-open {
    grid-template-columns: 316px minmax(0, 1fr);
  }

  .workspace-sidebar {
    width: 60px;
    max-width: 60px;
    grid-template-columns: 60px 0;
  }

  .workspace-frame--panel-open .workspace-sidebar {
    width: 316px;
    max-width: 316px;
    grid-template-columns: 60px minmax(0, 256px);
  }

  .workspace-composer-wrap {
    right: 28px;
    left: 28px;
  }
}

@media (max-width: 900px) {
  .workspace-page {

  }

  .workspace-header {
    height: 60px;
    max-height: 60px;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
    padding: 0 10px;
  }

  .workspace-header__left {
    grid-template-columns: auto minmax(120px, 1fr);
    gap: 9px;
  }

  .workspace-logo {
    height: 42px;
    gap: 8px;
  }

  .workspace-brand__mark {
    height: 31px;
    width: 31px;
    flex-basis: 31px;
  }

  .workspace-brand__name {
    font-size: 16px;
  }

  .workspace-search-pill {
    height: 40px;
    justify-content: flex-start;
    padding: 0 14px;
    font-size: 12px;
  }

  .workspace-header__nav {
    gap: 10px;
  }

  .workspace-header__nav .workspace-blog-menu,
  .workspace-theme-toggle {
    display: none;
  }

  .workspace-nav-link {
    height: 40px;
    font-size: 15px;
  }

  .workspace-nav-link svg {
    height: 19px;
    width: 19px;
  }

  .workspace-sign-in {
    height: 38px;
    padding: 0 14px;
    font-size: 15px;
  }

  .workspace-frame {
    position: relative;
    min-height: calc(100vh - 60px);
    min-height: 540px;
    margin: 0;
    grid-template-columns: 60px minmax(0, 1fr);
    border-radius: 20px 20px 0 0;
  }

  .workspace-sidebar {
    position: relative;
    z-index: 10;
    width: 60px;
    max-width: 60px;
    grid-template-columns: 60px 0;
    border-radius: 20px 0 20px 20px;
    overflow: visible;
  }

  .workspace-frame--panel-open {
    grid-template-columns: 60px minmax(0, 1fr);
  }

  .workspace-frame--panel-open .workspace-sidebar {
    width: 330px;
    max-width: min(330px, 88vw);
    grid-template-columns: 60px minmax(0, 270px);
  }

  .workspace-sidebar__rail {
    border-radius: 20px 0 0 20px;
  }

  .workspace-panel-toggle {
    height: 82px;
  }

  .workspace-panel-toggle svg {
    height: 34px;
    width: 34px;
  }

  .workspace-sidebar__panel {
    height: 100%;
    background: #f4f4f4;
    box-shadow: 20px 0 40px rgb(0 0 0 / 0.12);
  }

  .workspace-panel-heading {
    height: 82px;
  }

  .workspace-panel-content {
    height: calc(100% - 82px);
  }

  .workspace-canvas {
    grid-column: 2;
  }

  .site-workspace-main {
    grid-column: 2;
    padding: 0;
  }

  .workspace-composer-wrap {
    right: 18px;
    bottom: 24px;
    left: 18px;
  }

  .workspace-composer {
    height: 92px;
    grid-template-columns: 46px minmax(0, 1fr) 46px auto;
    gap: 6px;
    border-radius: 20px;
    padding: 0 16px 0 10px;
  }

  .workspace-composer__icon {
    height: 42px;
    width: 42px;
  }

  .workspace-composer__icon svg {
    height: 25px;
    width: 25px;
  }

  .workspace-go {
    height: 38px;
    min-width: 58px;
    font-size: 18px;
  }

  .workspace-conversation {
    height: calc(100% - 122px);
    padding: 34px 18px 20px;
  }

  .home-hero,
  .home-split,
  .category-product-top,
  .category-product-bottom,
  .search-results-grid {
    grid-template-columns: 1fr;
  }

  .home-hero,
  .category-product-left,
  .category-product-right,
  .category-product-bottom,
  .search-hero {
    padding: 28px;
  }

  .home-category-grid,
  .home-blog-grid,
  .category-home-tool-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .category-product-left::after {
    display: none;
  }

  .category-product-top {
    min-height: 0;
  }
}

@media (max-width: 560px) {
  .workspace-header__left {
    grid-template-columns: auto minmax(88px, 1fr);
  }

  .workspace-brand__name {
    display: none;
  }

  .workspace-search-pill {
    padding: 0 10px;
    color: transparent;
    gap: 0;
  }

  .workspace-search-pill svg {
    color: rgb(255 255 255 / 0.9);
  }

  .workspace-header__nav .workspace-nav-link {
    width: 40px;
    justify-content: center;

    color: transparent;
    gap: 0;
  }

  .workspace-header__nav .workspace-nav-link svg {
    flex: 0 0 20px;
    color: #050505;
  }

  .workspace-sign-in {
    width: 40px;
    overflow: auto;
    color: transparent;
    padding: 0;
  }

  .workspace-sign-in::after {
    color: white;
    content: 'In';
    font-size: 13px;
  }

  .workspace-frame {
    grid-template-columns: 60px minmax(0, 1fr);
  }

  .workspace-sidebar {
    width: 60px;
    max-width: 60px;
    grid-template-columns: 60px 0;
  }

  .workspace-frame--panel-open .workspace-sidebar {
    max-width: 92vw;
    grid-template-columns: 60px minmax(0, calc(92vw - 60px));
  }

  .workspace-rail-actions {
    gap: 2px;
  }

  .workspace-rail-link {
    height: 48px;
  }

  .workspace-composer-wrap {
    right: 10px;
    bottom: 14px;
    left: 10px;
  }

  .workspace-composer {
    height: 74px;
    grid-template-columns: 36px minmax(0, 1fr) 36px 48px;
    gap: 3px;
    border-radius: 20px;
    padding: 0 9px;
  }

  .workspace-composer > input:not([type='file']) {
    font-size: 14px;
  }

  .workspace-composer__icon {
    height: 34px;
    width: 34px;
  }

  .workspace-composer__icon svg {
    height: 22px;
    width: 22px;
  }

  .workspace-go {
    height: 34px;
    min-width: 46px;
    font-size: 15px;
  }

  .home-hero,
  .category-product-left,
  .category-product-right,
  .category-product-bottom,
  .search-hero {
    padding: 20px;
  }

  .home-category-grid,
  .home-blog-grid,
  .home-metric-grid,
  .category-mode-grid,
  .category-home-tool-grid {
    grid-template-columns: 1fr;
  }

  .home-tool-row,
  .category-tool-grid a,
  .category-related-tool,
  .category-blog-list a {
    grid-template-columns: 44px minmax(0, 1fr);
  }

  .home-tool-row strong,
  .category-tool-grid small,
  .category-related-tool > svg,
  .category-blog-list a > svg {
    grid-column: 2;
  }
}

/* Custom Scrollbar styling */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background-color: #cbd5e1;
  border-radius: 10px;
}
::-webkit-scrollbar-thumb:hover {
  background-color: #94a3b8;
}
